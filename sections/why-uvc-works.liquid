{% comment %}
  Section: Why UVC Works
  Two-column layout — left: badge + heading + intro + feature rows with icons
                      right: product/science image in styled panel
  All content editable via theme customizer.
  Add via: Online Store → Customize → Add section → "Why UVC Works"
{% endcomment %}

<style>
  .hh-uvc {
    background: linear-gradient(135deg, #eef6fb 0%, #f4f8fc 60%, #edf4f0 100%);
    padding: 80px 0;
  }
  .hh-uvc__wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── Two-column layout ── */
  .hh-uvc__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: stretch; /* both columns same height */
  }

  /* ── LEFT: content ── */

  /* Badge */
  .hh-uvc__badge {
    display: inline-block;
    background: rgba(11, 79, 114, 0.08);
    color: #0b4f72;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    padding: 5px 12px;
    border: 1px solid rgba(11, 79, 114, 0.18);
    margin-bottom: 18px;
  }

  /* Heading */
  .hh-uvc__heading {
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 700;
    color: #0d1b2a;
    line-height: 1.2;
    letter-spacing: -0.5px;
    margin: 0 0 16px;
  }

  /* Intro */
  .hh-uvc__intro {
    font-size: 15px;
    color: #555;
    line-height: 1.8;
    margin: 0 0 36px;
    max-width: 480px;
  }

  /* Feature list */
  .hh-uvc__features {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hh-uvc__feature {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  /* Icon */
  .hh-uvc__feature-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #e8f4fb;
    flex-shrink: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hh-uvc__feature-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .hh-uvc__feature-icon--emoji {
    font-size: 22px;
    line-height: 1;
  }

  /* Text */
  .hh-uvc__feature-text {}
  .hh-uvc__feature-title {
    font-size: 15px;
    font-weight: 700;
    color: #0d1b2a;
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .hh-uvc__feature-desc {
    font-size: 14px;
    color: #666;
    line-height: 1.7;
    margin: 0;
  }

  /* ── RIGHT: image panel ── */
  .hh-uvc__image-panel {
    background: #0d1b2a;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    /* height is driven by the left column; image fills it */
    position: relative;
    min-height: 360px;
    max-height: 600px;
  }
  .hh-uvc__image-panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .hh-uvc__image-placeholder {
    width: 100%;
    height: 100%;
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d1b2a;
    color: rgba(255,255,255,0.2);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hh-uvc__layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hh-uvc { padding: 56px 0; }
    .hh-uvc__image-panel {
      min-height: 280px;
      max-height: 400px;
      position: relative;
    }
    .hh-uvc__image-placeholder { min-height: 280px; }
  }
</style>

<section class="hh-uvc">
  <div class="hh-uvc__wrap">
    <div class="hh-uvc__layout">

      <!-- LEFT: text content -->
      <div class="hh-uvc__left">

        {%- if section.settings.badge != blank -%}
          <div class="hh-uvc__badge">{{ section.settings.badge }}</div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="hh-uvc__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <p class="hh-uvc__intro">{{ section.settings.intro }}</p>
        {%- endif -%}

        <!-- Feature rows (blocks) -->
        {%- if section.blocks.size > 0 -%}
          <div class="hh-uvc__features">
            {%- for block in section.blocks -%}
              <div class="hh-uvc__feature" {{ block.shopify_attributes }}>

                <!-- Icon: image if uploaded, otherwise emoji fallback -->
                <div class="hh-uvc__feature-icon">
                  {%- if block.settings.icon_image != blank -%}
                    <img
                      src="{{ block.settings.icon_image | image_url: width: 88 }}"
                      alt="{{ block.settings.title | escape }}"
                      width="44"
                      height="44"
                      loading="lazy"
                    >
                  {%- elsif block.settings.icon_emoji != blank -%}
                    <span class="hh-uvc__feature-icon--emoji">{{ block.settings.icon_emoji }}</span>
                  {%- else -%}
                    <span class="hh-uvc__feature-icon--emoji">✦</span>
                  {%- endif -%}
                </div>

                <div class="hh-uvc__feature-text">
                  {%- if block.settings.title != blank -%}
                    <p class="hh-uvc__feature-title">{{ block.settings.title }}</p>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="hh-uvc__feature-desc">{{ block.settings.description }}</p>
                  {%- endif -%}
                </div>

              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>

      <!-- RIGHT: image panel -->
      <div class="hh-uvc__image-panel">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}"
            width="600"
            height="600"
            loading="lazy"
          >
        {%- else -%}
          <div class="hh-uvc__image-placeholder">Add image</div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why UVC Works",
  "tag": "section",
  "class": "hh-uvc-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Left column — text"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge label",
      "default": "Science-Backed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why UVC Light Works"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "UVC light at 260–270nm penetrates bacterial cell walls and disrupts the DNA structure — permanently destroying the organism's ability to reproduce."
    },
    {
      "type": "header",
      "content": "Right column — image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Science / product image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "UVC sterilization technology"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature row",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image (optional)",
          "info": "Small icon displayed in a circle. If left blank, the emoji below is used instead."
        },
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Icon emoji (fallback)",
          "default": "🧬",
          "info": "Used when no icon image is uploaded."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature title",
          "default": "Hospital-Used Technology"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature description",
          "default": "UVC is the same method used to sterilize surgical equipment and hospital rooms."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why UVC Works",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon_emoji": "🏥",
            "title": "Hospital-Used Technology",
            "description": "UVC is the same method used to sterilize surgical equipment and hospital rooms."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_emoji": "🧬",
            "title": "DNA-Level Destruction",
            "description": "UVC breaks the DNA bonds of bacteria, viruses, and mold — not just surfaces."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_emoji": "✅",
            "title": "Certified & Tested",
            "description": "CE, FCC, RoHS certified. Independently tested by Guangdong Detection Center of Microbiology."
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  Section: Hero Banner
  HimayaHome — UV Toothbrush Sanitizer
  Upload via: Online Store → Edit Code → sections → Add new section → paste this file
{% endcomment %}

<style>

    :root {
      --color-background: #ffffff;
      --color-foreground: #121212;
      --color-border: #ebebeb;
      --color-accent: #0b4f72;       /* HimayaHome teal-navy */
      --color-accent-hover: #083a54;
      --color-button: #121212;
      --color-button-text: #ffffff;
      --color-secondary-bg: #f6f9fb;
      --color-tag-bg: #e8f4fb;
      --color-tag-text: #0b4f72;
      --color-star: #f5a623;
      --color-muted: #6b7280;
      --font-body: 'Assistant', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-heading: 'Assistant', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --radius: 0px;       /* Dawn uses 0px border-radius by default */
      --section-gap: 60px;
      --container-width: 1200px;
      --transition: 0.25s ease;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-body);
      background: var(--color-background);
      color: var(--color-foreground);
      font-size: 16px;
      line-height: 1.6;
    }

    /* ── UTILITY ─────────────────────────────── */
    .container { max-width: var(--container-width); margin: 0 auto; padding: 0 24px; }
    .section { padding: var(--section-gap) 0; }
    .section--gray { background: var(--color-secondary-bg); }
    .section-title {
      font-size: clamp(24px, 3vw, 36px);
      font-weight: 700;
      letter-spacing: -0.5px;
      line-height: 1.2;
      margin-bottom: 8px;
    }
    .section-subtitle {
      font-size: 15px;
      color: var(--color-muted);
      margin-bottom: 40px;
    }
    .badge {
      display: inline-block;
      background: var(--color-tag-bg);
      color: var(--color-tag-text);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      padding: 4px 12px;
      margin-bottom: 12px;
    }

    /* ── BUTTONS ─────────────────────────────── */
    .btn {
      display: inline-block;
      padding: 14px 28px;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.5px;
      cursor: pointer;
      text-decoration: none;
      border: 2px solid transparent;
      transition: background var(--transition), color var(--transition), border-color var(--transition);
    }
    .btn--primary {
      background: var(--color-accent);
      color: #fff;
      border-color: var(--color-accent);
    }
    .btn--primary:hover { background: var(--color-accent-hover); border-color: var(--color-accent-hover); }
    .btn--secondary {
      background: transparent;
      color: var(--color-foreground);
      border-color: var(--color-foreground);
    }
    .btn--secondary:hover { background: var(--color-foreground); color: #fff; }
    .btn--white {
      background: #fff;
      color: var(--color-accent);
      border-color: #fff;
    }
    .btn--white:hover { background: var(--color-accent); color: #fff; border-color: var(--color-accent); }

    /* ═══════════════════════════════════════════
       ANNOUNCEMENT BAR  (Dawn: top of page)
    ═══════════════════════════════════════════ */
    .announcement-bar {
      background: var(--color-accent);
      color: #fff;
      text-align: center;
      font-size: 13px;
      font-weight: 600;
      padding: 10px 24px;
      letter-spacing: 0.4px;
    }
    .announcement-bar a { color: #fff; text-decoration: underline; margin-left: 8px; }

    /* ═══════════════════════════════════════════
       HEADER / NAV  (Dawn sticky header)
    ═══════════════════════════════════════════ */
    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--color-background);
      border-bottom: 1px solid var(--color-border);
    }
    .header__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 24px;
      max-width: var(--container-width);
      margin: 0 auto;
      gap: 24px;
    }
    .header__logo {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.5px;
      color: var(--color-accent);
      text-decoration: none;
      flex-shrink: 0;
    }
    .header__logo span { color: var(--color-foreground); }
    .header__nav { display: flex; gap: 32px; list-style: none; }
    .header__nav a {
      font-size: 14px;
      font-weight: 600;
      color: var(--color-foreground);
      text-decoration: none;
      letter-spacing: 0.3px;
      transition: color var(--transition);
    }
    .header__nav a:hover { color: var(--color-accent); }
    .header__icons { display: flex; gap: 18px; align-items: center; }
    .header__icons svg { width: 22px; height: 22px; cursor: pointer; }
    .header__cart-count {
      background: var(--color-accent);
      color: #fff;
      border-radius: 50%;
      font-size: 10px;
      font-weight: 700;
      width: 18px; height: 18px;
      display: flex; align-items: center; justify-content: center;
      margin-left: -8px; margin-top: -10px;
    }

    /* ═══════════════════════════════════════════
       HERO BANNER  — Informative split layout
       (Dawn: slideshow / banner section)
    ═══════════════════════════════════════════ */
    .hero {
      background: #04111e;
      min-height: 640px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      overflow: hidden;
    }

    /* ── LEFT PANEL: text & education ────────── */
    .hero__left {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 72px 48px 72px 60px;
      position: relative;
      z-index: 2;
    }

    /* "What is this?" label */
    .hero__what {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(56,189,248,0.12);
      border: 1px solid rgba(56,189,248,0.35);
      color: #38bdf8;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      padding: 6px 14px;
      width: fit-content;
      margin-bottom: 20px;
    }
    .hero__what-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: #38bdf8;
      animation: pulse 1.8s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.7); }
    }

    .hero__product-name {
      font-size: clamp(28px, 3.5vw, 44px);
      font-weight: 700;
      color: #ffffff;
      line-height: 1.15;
      letter-spacing: -1px;
      margin-bottom: 10px;
    }
    .hero__product-name span { color: #38bdf8; }

    .hero__one-liner {
      font-size: 15px;
      color: rgba(255,255,255,0.6);
      font-style: italic;
      margin-bottom: 28px;
      padding-bottom: 28px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    /* Problem → Solution mini explainer */
    .hero__explainer {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 32px;
    }
    .hero__explainer-row {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }
    .hero__explainer-icon {
      flex-shrink: 0;
      width: 30px; height: 30px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px;
      margin-top: 1px;
    }
    .hero__explainer-icon--bad  { background: rgba(239,68,68,0.2); }
    .hero__explainer-icon--good { background: rgba(56,189,248,0.15); }
    .hero__explainer-text {
      font-size: 14px;
      line-height: 1.55;
    }
    .hero__explainer-text strong { color: #fff; display: block; font-size: 13px; }
    .hero__explainer-text span { color: rgba(255,255,255,0.55); font-size: 13px; }

    /* Arrow connector between bad/good */
    .hero__explainer-arrow {
      text-align: center;
      color: #38bdf8;
      font-size: 18px;
      line-height: 1;
      padding-left: 6px;
    }

    .hero__buttons { display: flex; gap: 12px; flex-wrap: wrap; }

    /* Proof row at bottom of left panel */
    .hero__proof {
      display: flex;
      gap: 24px;
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    .hero__proof-item { display: flex; align-items: center; gap: 8px; }
    .hero__proof-item strong { font-size: 18px; font-weight: 700; color: #38bdf8; }
    .hero__proof-item span { font-size: 11px; color: rgba(255,255,255,0.5); letter-spacing: 0.5px; line-height: 1.4; }

    /* ── RIGHT PANEL: product + callouts ─────── */
    .hero__right {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 32px 40px 0;
    }

    /* Atmospheric glow behind product */
    .hero__right::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 55% 50%, rgba(56,189,248,0.13) 0%, transparent 65%);
      pointer-events: none;
    }

    .hero__product-img {
      position: relative; z-index: 1;
      width: 88%;
      max-width: 420px;
      object-fit: contain;
      display: block;
      filter: drop-shadow(0 0 32px rgba(56,189,248,0.25));
    }

    /* Callout annotation bubbles */
    .callout {
      position: absolute;
      z-index: 3;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .callout__dot {
      width: 10px; height: 10px;
      background: #38bdf8;
      border-radius: 50%;
      border: 2px solid rgba(56,189,248,0.4);
      flex-shrink: 0;
    }
    .callout__line {
      height: 1px;
      background: rgba(56,189,248,0.45);
      flex-shrink: 0;
    }
    .callout__bubble {
      background: rgba(4,17,30,0.88);
      border: 1px solid rgba(56,189,248,0.3);
      padding: 8px 12px;
      white-space: nowrap;
    }
    .callout__bubble strong {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: #fff;
      line-height: 1.3;
    }
    .callout__bubble span {
      font-size: 11px;
      color: rgba(255,255,255,0.5);
    }

    /* Individual callout positions */
    .callout--top-left  { top: 12%; left: 2%; flex-direction: row; }
    .callout--mid-left  { top: 44%; left: 0%;  flex-direction: row; }
    .callout--bot-left  { bottom: 16%; left: 4%; flex-direction: row; }
    .callout--top-right { top: 18%; right: 2%; flex-direction: row-reverse; }
    .callout--bot-right { bottom: 22%; right: 2%; flex-direction: row-reverse; }

    /* ── RESPONSIVE ──────────────────────────── */
    @media (max-width: 850px) {
      .hero { grid-template-columns: 1fr; min-height: auto; }
      .hero__right { display: none; }
      .hero__left { padding: 56px 24px 60px; }
      .hero__proof { gap: 16px; }
    }

    /* ═══════════════════════════════════════════
       TRUST BADGES  (Dawn: icon-blocks section)
    ═══════════════════════════════════════════ */
    .trust-bar {
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      padding: 22px 0;
    }
    .trust-bar__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }
    .trust-item {
      display: flex; align-items: center; gap: 12px;
      padding: 8px 0;
    }
    .trust-item__icon {
      width: 40px; height: 40px; flex-shrink: 0;
      background: var(--color-tag-bg);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px;
    }
    .trust-item__text strong { display: block; font-size: 13px; font-weight: 700; }
    .trust-item__text span { font-size: 12px; color: var(--color-muted); }

    /* ═══════════════════════════════════════════
       WHY UV SECTION
    ═══════════════════════════════════════════ */
    .why-uv__layout {
      display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;
    }

    /* ── Custom illustration image ──────────── */
    .why-uv__illustration {
      width: 100%;
      display: block;
      border: 1px solid var(--color-border);
      box-shadow: 0 4px 24px rgba(11,79,114,0.10);
    }

    .why-uv__stats {
      display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 32px;
    }
    .stat-card {
      background: var(--color-secondary-bg);
      border-left: 4px solid var(--color-accent);
      padding: 16px 18px;
    }
    .stat-card__value { font-size: 28px; font-weight: 700; color: var(--color-accent); }
    .stat-card__label { font-size: 13px; color: var(--color-muted); margin-top: 4px; }

    /* ═══════════════════════════════════════════
       FEATURED PRODUCTS  (Dawn: featured-collection)
    ═══════════════════════════════════════════ */
    .products__grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 32px;
    }
    .product-card {
      border: 1px solid var(--color-border);
      transition: box-shadow var(--transition);
      overflow: hidden;
    }
    .product-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,0.08); }
    .product-card__image-wrap {
      position: relative;
      background: var(--color-secondary-bg);
      height: 360px;
      overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .product-card__image-wrap img { width: 100%; height: 100%; object-fit: contain; }
    .product-card__image-wrap img.img--light-bg { background: #f4f8fb; padding: 16px; }
    .product-card__tag {
      position: absolute; top: 16px; left: 16px;
      background: var(--color-accent);
      color: #fff;
      font-size: 11px; font-weight: 700;
      letter-spacing: 1px; text-transform: uppercase;
      padding: 4px 10px;
    }
    .product-card__body { padding: 24px; }
    .product-card__name {
      font-size: 18px; font-weight: 700; margin-bottom: 6px; line-height: 1.3;
    }
    .product-card__tagline {
      font-size: 13px; color: var(--color-accent); font-weight: 600; margin-bottom: 12px;
    }
    .product-card__features {
      list-style: none; display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px;
    }
    .product-card__features li {
      font-size: 13px; color: var(--color-muted);
      display: flex; align-items: center; gap: 8px;
    }
    .product-card__features li::before {
      content: "✓"; color: var(--color-accent); font-weight: 700; font-size: 12px;
    }
    .product-card__footer {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      border-top: 1px solid var(--color-border); padding-top: 18px;
    }
    .product-card__price { font-size: 22px; font-weight: 700; }
    .product-card__price-note { font-size: 12px; color: var(--color-muted); }

    /* ═══════════════════════════════════════════
       HOW IT WORKS  (Dawn: steps / icon-blocks)
    ═══════════════════════════════════════════ */
    .steps__grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; position: relative;
    }
    .steps__grid::before {
      content: '';
      position: absolute;
      top: 36px; left: calc(16.6% + 36px); right: calc(16.6% + 36px);
      height: 2px; background: var(--color-border);
    }
    .step { text-align: center; }
    .step__num {
      width: 72px; height: 72px; border-radius: 50%;
      background: var(--color-accent);
      color: #fff;
      font-size: 26px; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 20px;
      position: relative; z-index: 1;
    }
    .step__title { font-size: 16px; font-weight: 700; margin-bottom: 8px; }
    .step__text { font-size: 14px; color: var(--color-muted); line-height: 1.6; }

    /* ═══════════════════════════════════════════
       SCIENCE SECTION  (Dawn: image with text)
    ═══════════════════════════════════════════ */
    .science__layout {
      display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;
    }
    .science__image {
      background: var(--color-secondary-bg);
      aspect-ratio: 4/3;
      overflow: hidden; display: flex; align-items: center; justify-content: center;
    }
    .science__image img { width: 100%; height: 100%; object-fit: contain; padding: 24px; }
    .science__bullets { display: flex; flex-direction: column; gap: 18px; margin-top: 24px; }
    .science__bullet { display: flex; gap: 16px; align-items: flex-start; }
    .science__bullet-icon {
      width: 40px; height: 40px; flex-shrink: 0;
      background: var(--color-tag-bg);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px;
    }
    .science__bullet-text strong { display: block; font-size: 14px; font-weight: 700; margin-bottom: 2px; }
    .science__bullet-text span { font-size: 13px; color: var(--color-muted); }

    /* ═══════════════════════════════════════════
       TESTIMONIALS  (Dawn: testimonials section)
    ═══════════════════════════════════════════ */
    .testimonials__grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
    }
    .testimonial {
      border: 1px solid var(--color-border);
      padding: 28px 24px;
      transition: box-shadow var(--transition);
    }
    .testimonial:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
    .testimonial__stars { color: var(--color-star); font-size: 16px; margin-bottom: 12px; }
    .testimonial__text {
      font-size: 14px; color: var(--color-foreground); line-height: 1.7;
      margin-bottom: 16px; font-style: italic;
    }
    .testimonial__author { font-size: 13px; font-weight: 700; }
    .testimonial__role { font-size: 12px; color: var(--color-muted); }

    /* ═══════════════════════════════════════════
       FOOTER CTA  (Dawn: email signup / cta section)
    ═══════════════════════════════════════════ */
    .footer-cta {
      background: linear-gradient(135deg, #0b3d5e, #1565a0);
      color: #fff; text-align: center; padding: 80px 24px;
    }
    .footer-cta h2 { font-size: clamp(26px, 4vw, 42px); font-weight: 700; margin-bottom: 16px; letter-spacing: -0.5px; }
    .footer-cta p { font-size: 16px; color: rgba(255,255,255,0.78); margin-bottom: 36px; }

    /* ═══════════════════════════════════════════
       SITE FOOTER  (Dawn: footer)
    ═══════════════════════════════════════════ */
    .site-footer {
      border-top: 1px solid var(--color-border);
      padding: 48px 0 24px;
    }
    .site-footer__grid {
      display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 40px;
    }
    .site-footer__brand { }
    .site-footer__logo { font-size: 18px; font-weight: 700; color: var(--color-accent); margin-bottom: 12px; }
    .site-footer__tagline { font-size: 13px; color: var(--color-muted); line-height: 1.7; margin-bottom: 18px; }
    .site-footer__col h4 { font-size: 13px; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 14px; }
    .site-footer__col ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
    .site-footer__col a { font-size: 13px; color: var(--color-muted); text-decoration: none; }
    .site-footer__col a:hover { color: var(--color-accent); }
    .site-footer__bottom {
      border-top: 1px solid var(--color-border); padding-top: 20px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .site-footer__bottom p { font-size: 12px; color: var(--color-muted); }
    .payment-icons { display: flex; gap: 8px; }
    .payment-icon {
      background: #f3f4f6; border: 1px solid var(--color-border);
      border-radius: 4px; padding: 4px 8px;
      font-size: 10px; font-weight: 700; color: var(--color-muted);
    }

    /* ── RESPONSIVE ──────────────────────────── */
    @media (max-width: 900px) {
      .why-uv__layout, .science__layout { grid-template-columns: 1fr; gap: 32px; }
      .products__grid { grid-template-columns: 1fr; }
      .testimonials__grid { grid-template-columns: 1fr; }
      .steps__grid { grid-template-columns: 1fr; }
      .steps__grid::before { display: none; }
      .site-footer__grid { grid-template-columns: 1fr 1fr; }
      .trust-bar__grid { grid-template-columns: 1fr 1fr; }
      /* hero responsive rules handled inside .hero block above */
    }
    @media (max-width: 600px) {
      .header__nav { display: none; }
      .site-footer__grid { grid-template-columns: 1fr; }
      .trust-bar__grid { grid-template-columns: 1fr; }
    }

    /* ── DAWN ANNOTATION ─────────────────────── */
    .annotation {
      display: inline-block;
      background: #fff3cd;
      border: 1px dashed #f59e0b;
      color: #92400e;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.5px;
      padding: 3px 8px;
      margin-bottom: 6px;
      text-transform: uppercase;
    }
</style>

<section class="hh-hero">

  <!-- ══ LEFT: Educate the visitor ══ -->
  <div class="hh-hero__left">

    <div class="hh-hero__label">
      <div class="hh-hero__label-dot"></div>
      UV Toothbrush Sanitizer
    </div>

    <h1 class="hh-hero__headline">
      Testing Smart Device That<br>
      <span>Kills Bacteria</span> on<br>
      Your Toothbrush
    </h1>

    <p class="hh-hero__sub">
      Powered by hospital-grade UVC light — the same technology used to sterilize surgical equipment.
    </p>

    <div class="hh-hero__explainer">

      <div class="hh-hero__explainer-row">
        <div class="hh-hero__explainer-icon hh-hero__explainer-icon--bad">🦠</div>
        <div class="hh-hero__explainer-copy">
          <strong>The Problem</strong>
          <span>Your toothbrush sits in open air after every use. Within hours, airborne bacteria, toilet flush particles, and mold colonise the bristles — and you can't see any of it.</span>
        </div>
      </div>

      <div class="hh-hero__explainer-arrow">↓</div>

      <div class="hh-hero__explainer-row">
        <div class="hh-hero__explainer-icon hh-hero__explainer-icon--good">✨</div>
        <div class="hh-hero__explainer-copy">
          <strong>The Solution</strong>
          <span>Place your toothbrush inside our UV sanitizer. UVC light runs a 99-second cycle — destroying 99.9% of bacteria at the DNA level. No chemicals. No manual effort.</span>
        </div>
      </div>

    </div>

    <a href="#products" class="hh-hero__cta">See the Products</a>

    <div class="hh-hero__proof">
      <div class="hh-hero__proof-item">
        <strong>99.9%</strong>
        <span>Bacteria<br>eliminated</span>
      </div>
      <div class="hh-hero__proof-item">
        <strong>99s</strong>
        <span>Full<br>cycle time</span>
      </div>
      <div class="hh-hero__proof-item">
        <strong>4.9★</strong>
        <span>Customer<br>rating</span>
      </div>
      <div class="hh-hero__proof-item">
        <strong>CE</strong>
        <span>Lab<br>certified</span>
      </div>
    </div>

  </div>

  <!-- ══ RIGHT: Product image + callouts ══ -->
  <div class="hh-hero__right">

    {% if section.settings.product_image != blank %}
      <img
        class="hh-hero__product-img"
        src="{{ section.settings.product_image | image_url: width: 900 }}"
        alt="{{ section.settings.image_alt | escape }}"
        width="420"
        height="auto"
        loading="eager"
      >
    {% else %}
      {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}

    <!-- Callout: UVC light beam — top left -->
    <div class="hh-callout hh-callout--top-left">
      <div class="hh-callout__bubble">
        <strong>UVC Light Beam</strong>
        <span>Kills 99.9% of bacteria</span>
      </div>
      <div class="hh-callout__line" style="width:36px;"></div>
      <div class="hh-callout__dot"></div>
    </div>

    <!-- Callout: LED clock display — mid left -->
    <div class="hh-callout hh-callout--mid-left">
      <div class="hh-callout__bubble">
        <strong>LED Clock Display</strong>
        <span>Auto-sterilizes at set times</span>
      </div>
      <div class="hh-callout__line" style="width:48px;"></div>
      <div class="hh-callout__dot"></div>
    </div>

    <!-- Callout: No-drill wall mount — bottom left -->
    <div class="hh-callout hh-callout--bot-left">
      <div class="hh-callout__bubble">
        <strong>No-Drill Wall Mount</strong>
        <span>Adhesive back, easy install</span>
      </div>
      <div class="hh-callout__line" style="width:36px;"></div>
      <div class="hh-callout__dot"></div>
    </div>

    <!-- Callout: 3 rinse cups — top right -->
    <div class="hh-callout hh-callout--top-right">
      <div class="hh-callout__dot"></div>
      <div class="hh-callout__line" style="width:40px;"></div>
      <div class="hh-callout__bubble">
        <strong>3 Rinse Cups Included</strong>
        <span>Family-ready storage</span>
      </div>
    </div>

    <!-- Callout: holds 4 brushes — bottom right -->
    <div class="hh-callout hh-callout--bot-right">
      <div class="hh-callout__dot"></div>
      <div class="hh-callout__line" style="width:36px;"></div>
      <div class="hh-callout__bubble">
        <strong>Holds 4 Brushes + Razor</strong>
        <span>Fits whole family</span>
      </div>
    </div>

  </div>

</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hh-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "HimayaHome UV Toothbrush Sanitizer"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}